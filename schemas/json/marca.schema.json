        "type": "string"
      },
      "title": "Forbidden Claims",
      "type": "array"
    },
    "voice_notes": {
      "default": "",
      "title": "Voice Notes",
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "title": "BrandProfile",
  "type": "object"
