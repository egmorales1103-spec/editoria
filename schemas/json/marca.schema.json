          "type": "string"
        },
        "accent": {
          "default": "#FFD400",
          "title": "Accent",
          "type": "string"
        },
        "text": {
          "default": "#FFFFFF",
          "title": "Text",
          "type": "string"
        },
        "bg": {
          "default": "#000000",
          "title": "Bg",
          "type": "string"
        }
      },
      "title": "BrandColors",
      "type": "object"
    },
    "BrandFonts": {
      "additionalProperties": false,
      "properties": {
        "heading": {
          "default": "Inter",
          "title": "Heading",
          "type": "string"
