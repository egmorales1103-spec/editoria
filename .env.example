# Copiá este archivo a .env (nunca se versiona).

# Carpeta de proyectos (por defecto ./proyectos)
# EDITORIA_PROJECTS=C:\dev\editoria\proyectos

# Cliente experimental de Higgsfield (apagado por defecto; requiere presupuesto en proyecto.yaml)
# HIGGSFIELD_API_KEY=
# EDITORIA_HIGGSFIELD_API=0

# Modelo de transcripción (large-v3-turbo | small | ...)
# EDITORIA_WHISPER_MODEL=large-v3-turbo
