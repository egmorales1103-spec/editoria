{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "chat_burbujas",
  "type": "object",
  "additionalProperties": false,
  "required": ["mensajes"],
  "properties": {
    "mensajes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lado", "texto"],
        "properties": {
          "lado": {"enum": ["izq", "der"]},
          "texto": {"type": "string", "minLength": 1, "maxLength": 120}
        }
      }
    }
  },
  "examples": [
    {
      "mensajes": [
        {"lado": "izq", "texto": "¿Tienen turnos para mañana?"},
        {"lado": "der", "texto": "¡Sí! Te paso los horarios disponibles."},
        {"lado": "izq", "texto": "Perfecto, a las 10 me sirve"}
      ]
    }
  ]
}
